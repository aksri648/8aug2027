# ==============================================================================
# SaaS Agentic Development Platform - Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE API SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8080
ENV=production
JWT_SECRET=super-secret-jwt-token-signing-key-change-in-production-32bytes

# ------------------------------------------------------------------------------
# 2. POSTGRESQL PRIMARY DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL connection URL for Users, Projects, Messages, Skills, SecretRefs, Jobs
DATABASE_URL=postgres://saas_user:SecurePassword123!@localhost:5432/saas_agent_db?sslmode=disable

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & ASYNC JOB QUEUE
# ------------------------------------------------------------------------------
# Redis server address for pub/sub events & asynq job queue backing
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. DAYTONA CLOUD SANDBOX SDK
# ------------------------------------------------------------------------------
# Daytona API Key from https://www.daytona.io/
DAYTONA_API_KEY=daytona_ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET_REGION=us-east

# ------------------------------------------------------------------------------
# 5. MICROSOFT AZURE CLOUD PROVISIONING & KEY VAULT SECRETS
# ------------------------------------------------------------------------------
# Azure Key Vault URI for storing encrypted third-party credentials
AZURE_KEYVAULT_URI=https://saas-platform-vault.vault.azure.net/

# Azure Service Principal credentials for VM compute & container deployment
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-azure-service-principal-client-secret
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=saas-agent-platform-rg
AZURE_CONTAINER_REGISTRY=saasplatformcr.azurecr.io

# ------------------------------------------------------------------------------
# 6. GOOGLE ADK & LLM MODEL BACKING
# ------------------------------------------------------------------------------
# Gemini API Key used by Google ADK for Master Agent & specialist reasoning
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Hugging Face Hub token for downloading gated open-weight models (Llama-3, Mistral)
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA NGC API Key for pulling and running NVIDIA NIM container microservices
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 7. GITHUB INTEGRATION
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) for App Maintainer repo cloning & pushing
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
